@model SistemaCableInternet.BLL.Models.Plan

@{
    ViewData["Title"] = "Editar Plan";
}

<div class="container mt-4">

    <h2>Editar plan</h2>

    <div class="card mt-4">
        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="PlanId" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="ServicioId" class="form-label">
                        Servicio
                    </label>

                    <select asp-for="ServicioId"
                            asp-items="ViewBag.Servicios"
                            class="form-select">
                        <option value="">Seleccione un servicio</option>
                    </select>

                    <span asp-validation-for="ServicioId"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label">
                        Nombre del plan
                    </label>

                    <input asp-for="Nombre" class="form-control" />

                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="VelocidadMbps" class="form-label">
                        Velocidad (Mbps)
                    </label>

                    <input asp-for="VelocidadMbps"
                           type="number"
                           min="1"
                           class="form-control" />

                    <span asp-validation-for="VelocidadMbps"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Canales" class="form-label">
                        Cantidad de canales
                    </label>

                    <input asp-for="Canales"
                           type="number"
                           min="1"
                           class="form-control" />

                    <span asp-validation-for="Canales"
                          class="text-danger">
                    </span>
                </div>

                <div class="alert alert-info">
                    Ingresa la velocidad para planes de Internet
                    o la cantidad de canales para planes de Cable.
                    No debes completar ambos campos.
                </div>

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-primary">
                        Guardar cambios
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

