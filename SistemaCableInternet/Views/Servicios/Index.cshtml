@model List<SistemaCableInternet.BLL.Models.Servicio>

@{
    ViewData["Title"] = "Servicios";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Administración de Servicios</h2>

        <a asp-action="Create" class="btn btn-primary">
            Nuevo servicio
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Mensaje"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Buscar servicio</label>

                        <input type="text"
                               name="buscar"
                               value="@ViewBag.Buscar"
                               class="form-control"
                               placeholder="Escribe una descripción..." />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Estado</label>

                        <select name="activo" class="form-select">
                            <option value="">Todos</option>

                            <option value="true"
                                    selected="@(ViewBag.Activo is bool a && a)">
                                Activos
                            </option>

                            <option value="false"
                                    selected="@(ViewBag.Activo is bool a2 && !a2)">
                                Inactivos
                            </option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-dark w-100">
                            Buscar
                        </button>
                    </div>

                </div>

            </form>

        </div>
    </div>

    <div class="card">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var servicio in Model)
                            {
                                <tr>
                                    <td>@servicio.ServicioId</td>

                                    <td>@servicio.Descripcion</td>

                                    <td>
                                        @if (servicio.Activo)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">

                                        <a asp-action="Edit"
                                           asp-route-id="@servicio.ServicioId"
                                           class="btn btn-sm btn-warning">
                                            Editar
                                        </a>

                                        <form asp-action="CambiarEstado"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@servicio.ServicioId" />

                                            @if (servicio.Activo)
                                            {
                                                <input type="hidden"
                                                       name="activo"
                                                       value="false" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    Desactivar
                                                </button>
                                            }
                                            else
                                            {
                                                <input type="hidden"
                                                       name="activo"
                                                       value="true" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-success">
                                                    Activar
                                                </button>
                                            }

                                        </form>

                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">
                                    No se encontraron servicios registrados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <p class="text-muted mb-0">
                Total de servicios encontrados: @Model.Count
            </p>

        </div>
    </div>

</div>

