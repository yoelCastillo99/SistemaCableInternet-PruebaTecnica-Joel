@model SistemaCableInternet.BLL.Models.Cliente

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm">

                <div class="card-header bg-warning">
                    <h4 class="mb-0">Editar información del cliente</h4>
                </div>

                <div class="card-body">

                    <form asp-controller="Clientes"
                          asp-action="Edit"
                          asp-route-id="@Model.ClienteId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="ClienteId" />

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Codigo"
                                   class="form-label">
                                Código del cliente
                            </label>

                            <input asp-for="Codigo"
                                   class="form-control"
                                   maxlength="20"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Nombre"
                                   class="form-label">
                                Nombre completo
                            </label>

                            <input asp-for="Nombre"
                                   class="form-control"
                                   maxlength="150"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="FechaAlta"
                                   class="form-label">
                                Fecha de alta
                            </label>

                            <input asp-for="FechaAlta"
                                   type="date"
                                   class="form-control"
                                   asp-format="{0:yyyy-MM-dd}"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Direccion"
                                   class="form-label">
                                Dirección
                            </label>

                            <textarea asp-for="Direccion"
                                      class="form-control"
                                      rows="3"
                                      maxlength="250"
                                      required></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Correo"
                                   class="form-label">
                                Correo electrónico
                            </label>

                            <input asp-for="Correo"
                                   type="email"
                                   class="form-control"
                                   maxlength="254" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Telefono"
                                   class="form-label">
                                Teléfono
                            </label>

                            <input asp-for="Telefono"
                                   class="form-control"
                                   maxlength="30" />
                        </div>

                        <div class="d-flex justify-content-between mt-4">

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Regresar
                            </a>

                            <button type="submit"
                                    class="btn btn-warning">
                                Actualizar cliente
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

