@model List<SistemaCableInternet.BLL.Models.Contrato>

@{
    ViewData["Title"] = "Contratos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Administración de Contratos</h2>
            <p class="text-muted">
                Consulta y administra los contratos de los clientes.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Contrato
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Mensaje"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get">
                <div class="row g-3 align-items-end">

                    <div class="col-md-6">
                        <label class="form-label">Buscar cliente</label>
                        <input type="text"
                               name="buscar"
                               value="@ViewBag.Buscar"
                               class="form-control"
                               placeholder="Nombre o código del cliente" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Estado</label>
                        <select name="estado" class="form-select">
                            <option value="">Todos</option>

                            <option value="Activo"
                                    selected="@(ViewBag.Estado?.ToString() == "Activo")">
                                Activo
                            </option>

                            <option value="Suspendido"
                                    selected="@(ViewBag.Estado?.ToString() == "Suspendido")">
                                Suspendido
                            </option>

                            <option value="Finalizado"
                                    selected="@(ViewBag.Estado?.ToString() == "Finalizado")">
                                Finalizado
                            </option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            Buscar
                        </button>

                        <a asp-action="Index" class="btn btn-secondary">
                            Limpiar
                        </a>
                    </div>

                </div>
            </form>

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Contrato</th>
                            <th>Código</th>
                            <th>Cliente</th>
                            <th>Fecha de inicio</th>
                            <th>Fecha de finalización</th>
                            <th>Día de pago</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var contrato in Model)
                            {
                                <tr>
                                    <td>@contrato.ContratoId</td>
                                    <td>@contrato.Codigo</td>
                                    <td>@contrato.Cliente</td>

                                    <td>
                                        @contrato.FechaInicio.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @(contrato.FechaFin.HasValue
                                                                        ? contrato.FechaFin.Value.ToString("dd/MM/yyyy")
                                                                        : "Sin finalizar")
                            </td>

                                    <td>@contrato.DiaPago</td>

                                    <td>
                                @if (contrato.Estado == "Activo")
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else if (contrato.Estado == "Suspendido")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Suspendido
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Finalizado
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">

                                            <a asp-action="Edit"
                                               asp-route-id="@contrato.ContratoId"
                                               class="btn btn-sm btn-warning">
                                                Editar
                                            </a>

                                            @if (contrato.Estado == "Activo")
                                            {
                                                <form asp-action="CambiarEstado"
                                                      method="post">
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@contrato.ContratoId" />

                                                    <input type="hidden"
                                                           name="estado"
                                                           value="Suspendido" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-secondary">
                                                        Suspender
                                                    </button>
                                                </form>
                                            }
                                            else if (contrato.Estado == "Suspendido")
                                            {
                                                <form asp-action="CambiarEstado"
                                                      method="post">
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@contrato.ContratoId" />

                                                    <input type="hidden"
                                                           name="estado"
                                                           value="Activo" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-success">
                                                        Activar
                                                    </button>
                                                </form>
                                            }

                                            @if (contrato.Estado != "Finalizado")
                                            {
                                                <form asp-action="CambiarEstado"
                                                      method="post">
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@contrato.ContratoId" />

                                                    <input type="hidden"
                                                           name="estado"
                                                           value="Finalizado" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-danger">
                                                        Finalizar
                                                    </button>
                                                </form>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">
                                    No hay contratos registrados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>

            <p class="text-muted mb-0">
                Total de contratos encontrados: @(Model?.Count ?? 0)
            </p>

        </div>
    </div>

</div>

