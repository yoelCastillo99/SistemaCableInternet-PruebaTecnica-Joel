@model SistemaCableInternet.BLL.Models.Zona

@{
    ViewData["Title"] = "Nueva Zona";
}

<div class="container mt-4">

    <h2>Registrar Zona</h2>
    <p class="text-muted">Ingrese el nombre de la nueva zona de cobertura.</p>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label">
                        Nombre de la zona
                    </label>

                    <input asp-for="Nombre"
                           class="form-control"
                           maxlength="200"
                           placeholder="Ejemplo: Zona Norte" />

                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>
                </div>

                <hr />

                <button type="submit" class="btn btn-primary">
                    Guardar Zona
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
